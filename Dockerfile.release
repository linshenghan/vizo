# Vizo 发布镜像
# 由 build.sh 构建，输入为修补后的 .py 源码，在容器内编译为 .pyc

FROM python:3.11-slim

# 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Node.js（Claude Code CLI / Codex CLI 依赖）
# 优先 NodeSource 22.x，超时则用 Debian 自带 + npm
RUN (curl -fsSL --connect-timeout 15 https://deb.nodesource.com/setup_22.x | bash - 2>/dev/null \
    && apt-get install -y --no-install-recommends nodejs) \
    || (apt-get update && apt-get install -y --no-install-recommends nodejs npm) \
    && rm -rf /var/lib/apt/lists/*

# Claude Code CLI / Codex CLI / Playwright MCP，并预装 Chromium 运行时
RUN npm install -g @anthropic-ai/claude-code @openai/codex @playwright/mcp \
    && node "$(npm root -g)/@playwright/mcp/node_modules/playwright/cli.js" install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

ENV VIZO_RUNTIME_NPM_PREFIX=/usr/local

# Serena MCP（代码分析能力）
RUN pip install --no-cache-dir serena

WORKDIR /app

# Python 依赖（利用层缓存）
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制修补后的源码
COPY . .

# 预置系统集成 MCP，避免新部署用户手动安装
RUN cat > /app/.mcp.json <<'MCP_EOF'
{
  "mcpServers": {
    "serena": {
      "command": "serena",
      "args": ["start-mcp-server", "--project-from-cwd"]
    },
    "mcp-chrome": {
      "command": "python3",
      "args": ["lib/chrome_mcp_stdio.py"]
    },
    "vizo-router": {
      "command": "python3",
      "args": ["lib/vizo_router_mcp_stdio.py"]
    },
    "jina": {
      "command": "npx",
      "args": ["-y", "jina-mcp-tools"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--browser",
        "chromium",
        "--no-sandbox",
        "--isolated"
      ]
    }
  }
}
MCP_EOF

# 在容器内编译 .py → .pyc，然后删除 .py 源码
RUN python3 -m compileall -b -q -r 999 /app \
    && find /app -name "*.py" -not -name "*.pyc" -delete \
    && find /app -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true

# 初始化 Git 仓库（state_manager 的 worktree/回滚功能需要）
RUN git config --global user.email "vizo@container" \
    && git config --global user.name "Vizo" \
    && git init \
    && git add -A \
    && git commit -m "Docker initial commit" --allow-empty

# 运行时目录
RUN mkdir -p /app/.vizo /app/logs /app/projects/workspace

EXPOSE 9380

# 入口：secretary.pyc 管理 confirm_server 生命周期
CMD ["python3", "secretary.pyc"]
